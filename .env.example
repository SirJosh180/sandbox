# Postgres connection string. On Vercel this is added for you when you connect a Neon database.
# Leave it empty locally to use the built-in embedded database in ./data.
DATABASE_URL=

# The first admin account is created from these on the first request.
ADMIN_EMAIL=admin@yourschool.edu
ADMIN_PASSWORD=change-me-to-something-long

# Local only
PORT=3000
